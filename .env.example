# Database
# When the API runs in docker-compose, the database service is reachable as "postgres"
# (not localhost - inside the container localhost is the container itself).
# Use localhost only when you run the API outside docker.
POSTGRES_HOST = postgres
POSTGRES_PORT = 5432
POSTGRES_DB = undermine
POSTGRES_USER = undermine
POSTGRES_PASSWORD = 

# Startup migrations: retry while PostgreSQL is starting, then exit non-zero (fail fast).
Database__MigrateRetries=10
Database__MigrateRetryDelaySeconds=2
# Run migrations on startup. Primary: true. Standby/DR replicas: false (schema is already
# migrated by the primary/one-shot step).
Database__MigrateOnStartup=true

# JWT
Jwt__Key=
Jwt__Issuer=
Jwt__Audience=

# Default admin bootstrap
# On a fresh database the API creates an admin account with a RANDOM login and password and
# prints them to the log (docker logs undermine-api-api-1) the first time it starts, so the admin
# panel is reachable without touching the database by hand.
# Set Enabled=false to switch the behaviour off completely.
BootstrapAdminEnabled=true
# Set BOTH of these to use fixed credentials instead of a generated login/password.
# They also RESET that account (password and role are overwritten), which is the way back in
# if the generated password was lost.
BootstrapAdminUsername=
BootstrapAdminPassword=

# Redis (optional)
Redis__Host=
Redis__Port=
Redis__Username=
Redis__Password=
Redis__Ssl=

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=
ASPNETCORE_HTTP_PORTS=
ASPNETCORE_HTTPS_PORTS=
CurseForgeApiKey=

# Container images (override without editing docker-compose.yml).
POSTGRES_IMAGE=postgres:16
# Prefer a digest for reproducible deployments, e.g.
# MINIO_IMAGE=dhi.io/minio@sha256:...
MINIO_IMAGE=dhi.io/minio:latest
NGINX_IMAGE=nginx:1.27-alpine

# Java runtimes
# Temurin JRE archives are downloaded from Adoptium on the first request and cached on the
# java_data volume. CacheHours=0 forces a re-check on every request.
JavaRuntime__CacheHours=24
# Adoptium API used to resolve the latest GA JRE for a major version.
JavaRuntime__AdoptiumApiBaseUrl=https://api.adoptium.net

# Builds
# Run the build queue worker only on the primary node. Standby/DR: false.
Build__WorkerEnabled=true
Build__InstallerMaxHeapMb=1024
# Build logs older than N days are deleted by a background service (0 = keep forever).
Build__LogRetentionDays=30
Build__LogRetentionIntervalHours=24
# Optional per-build line cap (0 = disabled).
Build__LogRetentionMaxPerBuild=0

# Reverse proxy / forwarded headers
# X-Forwarded-For / X-Forwarded-Proto are trusted only from these addresses/networks.
# In docker-compose the trusted network is derived from PROXY_SUBNET (the frontend network
# shared by nginx and the API). Leave the lists empty when the API is accessed directly.
# PROXY_SUBNET must not clash with networks already used on the host.
PROXY_SUBNET=172.28.0.0/24
ForwardedHeaders__Enabled=true
ForwardedHeaders__ForwardLimit=1
ForwardedHeaders__KnownNetworks=
ForwardedHeaders__KnownProxies=

# Ban/role state behind an already issued JWT is cached for this many seconds.
Access__BanCacheSeconds=30

# CORS
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty in Production: the admin panel is same-origin and the launcher is not a browser.
# Development with an empty list allows any origin (without credentials).
CORS__AllowedOrigins=
# Only enable if a browser client really sends cookies (Bearer tokens do not need this).
CORS__AllowCredentials=false

# Security headers
# HSTS is sent only over HTTPS (directly or via X-Forwarded-Proto from nginx).
Security__HstsMaxAgeDays=365

# Registration limits
Registration__MaxAccountsPerDevice=2
Registration__MaxAccountsPerIp=4
# IPv4 is counted per exact address by default. Set 24 (or another prefix) to group a whole
# block and make IP rotation inside that block less useful.
Registration__Ipv4PrefixLength=32
# IPv6 clients usually control a whole /64, so addresses are grouped at /64.
Registration__Ipv6PrefixLength=64
Registration__DeviceIdMinLength=16
Registration__DeviceIdMaxLength=128

# Rate limiting (fixed window; authenticated requests are partitioned by user id, anonymous
# requests by the IP/subnet key above). Values are per window.
RateLimiting__Api__PermitLimit=120
RateLimiting__Api__WindowSeconds=60
RateLimiting__Admin__PermitLimit=600
RateLimiting__Admin__WindowSeconds=60
RateLimiting__Auth__PermitLimit=20
RateLimiting__Auth__WindowSeconds=60
RateLimiting__Register__PermitLimit=10
RateLimiting__Register__WindowSeconds=600
RateLimiting__Static__PermitLimit=1000
RateLimiting__Static__WindowSeconds=10

# Minio
MINIO_ROOT_USER = 
MINIO_ROOT_PASSWORD = 
S3__Endpoint = 
S3__AccessKey = 
S3__SecretKey = 
S3__Bucket = 
S3__UseSsl = 
# Required by startup validation: absolute public CDN URL WITHOUT the bucket name,
# e.g. http://localhost:8080 or https://cdn.example.com
S3__CdnBaseUrl = 
# Garage: bucket, key and website are provisioned by ansible/garage-bootstrap.yml.
# Set true only for MinIO/local development where the API should create the bucket itself.
S3__ManageBucket=false
# Anonymous object reads. With Garage s3_web this is false: access is handled by s3_web.
S3__PublicRead=true

