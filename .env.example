# Database
# When the API runs in docker-compose, the database service is reachable as "postgres"
# (not localhost - inside the container localhost is the container itself).
# Use localhost only when you run the API outside docker.
POSTGRES_HOST = postgres
POSTGRES_PORT = 5432
POSTGRES_DB = undermine
POSTGRES_USER = undermine
POSTGRES_PASSWORD = 

# JWT
Jwt__Key=
Jwt__Issuer=
Jwt__Audience=

# Default admin bootstrap
# On a fresh database the API creates an admin account with a RANDOM login and password and
# prints them to the log (docker logs undermine-api-api-1) the first time it starts, so the admin
# panel is reachable without touching the database by hand.
# Set Enabled=false to switch the behaviour off completely.
BootstrapAdminEnabled=true
# Set BOTH of these to use fixed credentials instead of a generated login/password.
# They also RESET that account (password and role are overwritten), which is the way back in
# if the generated password was lost.
BootstrapAdminUsername=
BootstrapAdminPassword=

# Redis (optional)
Redis__Host=
Redis__Port=
Redis__Username=
Redis__Password=
Redis__Ssl=

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=
ASPNETCORE_HTTP_PORTS=
ASPNETCORE_HTTPS_PORTS=
CurseForgeApiKey=

# Minio
MINIO_ROOT_USER = 
MINIO_ROOT_PASSWORD = 
S3__Endpoint = 
S3__AccessKey = 
S3__SecretKey = 
S3__Bucket = 
S3__UseSsl = 
S3__CdnBaseUrl = 

