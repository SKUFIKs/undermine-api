# TLS variant of nginx.conf.
#
# Usage:
#   1. Put the certificate and key into ./certs/ (fullchain.pem, privkey.pem).
#   2. Copy this file:  cp nginx.tls.conf.example nginx.tls.conf
#   3. Start with the override: docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
#
# The API itself keeps serving plain HTTP on the private network; nginx terminates TLS and sends
# X-Forwarded-Proto: https, so the API also emits HSTS (see SecurityHeadersMiddleware).

events {
    worker_connections 1024;
}

http {
    proxy_cache_path /var/cache/nginx/build levels=1:2 keys_zone=build_cache:32m max_size=4g inactive=7d use_temp_path=off;

    # HTTP -> HTTPS. /health stays plain so container probes do not need TLS.
    server {
        listen 80;

        location /health {
            return 200 'OK';
        }

        location / {
            return 308 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;   # nginx >= 1.25.1
        server_name _;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # Resolve Docker service names per request (see nginx.conf for details).
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api_upstream http://api:8080;

        location /health {
            return 200 'OK';
        }

        location /api/ {
            proxy_pass $api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;

            client_max_body_size 1024m;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
        }

        location /admin/ {
            proxy_pass $api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /admin {
            return 308 /admin/;
        }

        location = /metrics {
            proxy_pass $api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
        }

        location /builds/ {
            proxy_pass http://minio:9000/minecraft-builds/builds/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_cache build_cache;
            proxy_cache_valid 200 7d;
            proxy_cache_valid 404 1m;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            add_header X-Cache-Status $upstream_cache_status always;

            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD" always;
            add_header Access-Control-Allow-Headers "*" always;
        }

        location / {
            proxy_pass http://minio:9000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_cache build_cache;
            proxy_cache_valid 200 7d;
            proxy_cache_valid 404 1m;

            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, HEAD" always;
            add_header Access-Control-Allow-Headers "*" always;
        }
    }
}
