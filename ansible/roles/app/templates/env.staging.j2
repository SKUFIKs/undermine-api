# Managed by Ansible from HashiCorp Vault
POSTGRES_HOST={{ pg_host | default('127.0.0.1') }}
POSTGRES_PORT={{ pg_port | default('5432') }}
POSTGRES_DB={{ app_db_name }}
POSTGRES_USER={{ app_user }}
POSTGRES_PASSWORD={{ app_db_password | default(vault_app_pass) }}

ConnectionStrings__PostgreConnection=Host={{ pg_host | default('127.0.0.1') }};Port={{ pg_port | default('5432') }};Database={{ app_db_name }};Username={{ app_user }};Password={{ app_db_password | default(vault_app_pass) }}

{% for key, value in app_env_vars | dictsort %}
{{ key }}={{ value }}
{% endfor %}