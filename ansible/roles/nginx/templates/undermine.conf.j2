upstream api_backend {
    server 127.0.0.1:5000;
    keepalive 32;
}

# Garage s3_web: public bucket website endpoint (loopback only).
upstream garage_web_backend {
    server 127.0.0.1:3902;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ api_url }} {{ staging_url }} {{ cdn_url }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    http2 on;
    server_name {{ api_url }};

    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    ssl_certificate /etc/letsencrypt/live/{{ api_url }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ api_url }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy same-origin;
    client_max_body_size 2048m;
    client_body_timeout 120s;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr; # Здесь уже будет реальный IP благодаря real_ip_header proxy_protocol
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    # --- Роутинг ---
    location /api/ {
        proxy_pass http://api_backend;
    }

    location /health {
        proxy_pass http://api_backend;
    }

    # Prometheus scrape endpoint. Restrict by source IP here and optionally add
    # Metrics__Token on the API for a second layer.
    location = /metrics {
{% if api_metrics_allowed_ips | default([]) | length > 0 %}
{% for cidr in api_metrics_allowed_ips %}
        allow {{ cidr }};
{% endfor %}
        deny all;
{% endif %}
        proxy_pass http://api_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_buffering off;
    }

    location /admin/ {
        proxy_pass http://api_backend;
    }

    location /builds/ {
        # Garage s3_web routes by Host: <bucket>.<root_domain>.
        proxy_pass http://garage_web_backend;
        proxy_set_header Host {{ s3_bucket }}.{{ garage_web_root_domain }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location ~ /\.ht {
        deny all;
    }
}

server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    http2 on;
    server_name {{ cdn_url }};

    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    ssl_certificate /etc/letsencrypt/live/{{ api_url }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ api_url }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy same-origin;

    client_max_body_size 2048m;
    client_body_timeout 120s;

    location /builds/ {
        # Garage s3_web routes by Host: <bucket>.<root_domain>.
        proxy_pass http://garage_web_backend;
        proxy_set_header Host {{ s3_bucket }}.{{ garage_web_root_domain }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location / {
        return 404;
    }

    location ~ /\.ht {
        deny all;
    }
}
