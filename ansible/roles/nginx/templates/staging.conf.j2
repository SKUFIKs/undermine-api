upstream api_staging_backend {
    server 127.0.0.1:5000;
    keepalive 32;
}

# Garage s3_web: staging bucket website endpoint (loopback only).
upstream garage_staging_web_backend {
    server 127.0.0.1:3902;
    keepalive 32;
}

server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    http2 on;
    server_name {{ staging_url }};

    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    ssl_certificate /etc/letsencrypt/live/{{ api_url }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ api_url }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy same-origin;

    client_max_body_size 2048m;
    client_body_timeout 120s;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    # Do not put auth_basic at server level: the admin SPA sends
    # "Authorization: Bearer ..." for /api/ requests, and that header replaces
    # the browser's Basic credentials. Protect /admin/ with Basic, but let
    # /api/ use the app's JWT auth.

    location /health {
        auth_basic off;
        allow all;
        proxy_pass http://api_staging_backend;
    }

    location /api/ {
        auth_basic off;
{% if staging_ip_allowlist | default([]) | length > 0 %}
{% for cidr in staging_ip_allowlist %}
        allow {{ cidr }};
{% endfor %}
        deny all;
{% endif %}
        proxy_pass http://api_staging_backend;
    }

    location /admin/ {
{% if staging_basic_auth_enabled | bool and vault_staging_basic_auth | default('') | length > 0 %}
        auth_basic "UnderMine staging";
        auth_basic_user_file {{ staging_basic_auth_file }};
{% endif %}
{% if staging_ip_allowlist | default([]) | length > 0 %}
        satisfy any;
{% for cidr in staging_ip_allowlist %}
        allow {{ cidr }};
{% endfor %}
        deny all;
{% elif not (staging_basic_auth_enabled | bool and vault_staging_basic_auth | default('') | length > 0) %}
        deny all;
{% endif %}
        proxy_pass http://api_staging_backend;
    }

    location /builds/ {
        # Build artifacts are public in the staging bucket; do not require
        # basic auth for them.
        auth_basic off;
        allow all;
        proxy_pass http://garage_staging_web_backend;
        proxy_set_header Host {{ garage_staging_bucket }}.{{ garage_web_root_domain }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location / {
        return 404;
    }

    location ~ /\.ht {
        deny all;
    }
}
