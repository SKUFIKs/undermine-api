[Unit]
Description=Garage Object Storage
After=network-online.target
Wants=network-online.target

[Service]
User={{ garage_user }}
Group={{ garage_group }}
ExecStart=/usr/local/bin/garage -c {{ garage_config_file }} server
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
