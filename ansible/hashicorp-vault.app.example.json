{
  "ASPNETCORE_ENVIRONMENT": "Production",
  "ASPNETCORE_URLS": "http://+:8080",
  "BootstrapAdmin__Username": "CHANGE_ME",
  "BootstrapAdmin__Password": "CHANGE_ME",
  "RateLimiting__Api__PermitLimit": "120",
  "RateLimiting__Api__WindowSeconds": "60",
  "RateLimiting__Admin__PermitLimit": "600",
  "RateLimiting__Admin__WindowSeconds": "60",
  "RateLimiting__Auth__PermitLimit": "20",
  "RateLimiting__Auth__WindowSeconds": "60",
  "RateLimiting__Register__PermitLimit": "10",
  "RateLimiting__Register__WindowSeconds": "600",
  "RateLimiting__Static__PermitLimit": "1000",
  "RateLimiting__Static__WindowSeconds": "10",
  "Registration__MaxAccountsPerDevice": "2",
  "Registration__MaxAccountsPerIp": "4",
  "Registration__Ipv4PrefixLength": "32",
  "Registration__Ipv6PrefixLength": "64",
  "Registration__DeviceIdMinLength": "16",
  "Registration__DeviceIdMaxLength": "128",
  "Access__BanCacheSeconds": "30",
  "Database__MigrateRetries": "10",
  "Database__MigrateRetryDelaySeconds": "2",
  "Jwt__Key": "CHANGE_ME_MIN_32_CHARS",
  "Jwt__Issuer": "UnderMine",
  "Jwt__Audience": "UnderMine",
  "CurseForge__ApiKey": "CHANGE_ME_CURSEFORGE_API_KEY",
  "S3__Endpoint": "127.0.0.1:3900",
  "S3__Region": "us-east-1",
  "S3__UseSsl": "false",
  "S3__Bucket": "undermine-builds",
  "S3__AccessKey": "CHANGE_ME_GARAGE_KEY_ID",
  "S3__SecretKey": "CHANGE_ME_GARAGE_SECRET",
  "S3__PublicRead": "false",
  "S3__ManageBucket": "false",
  "S3__CdnBaseUrl": "https://cdn.example.com",
  "S3__FallbackCdnBaseUrl": "",
  "Build__RootPath": "/app/builds",
  "Build__WorkerEnabled": "true",
  "Database__MigrateOnStartup": "false",
  "JavaRuntime__RootPath": "/app/java",
  "ForwardedHeaders__Enabled": "true",
  "ForwardedHeaders__ForwardLimit": "1",
  "ForwardedHeaders__KnownNetworks": "127.0.0.1/32",
  "ForwardedHeaders__KnownProxies": "",
  "CORS__AllowedOrigins": "",
  "CORS__AllowCredentials": "false"
}
